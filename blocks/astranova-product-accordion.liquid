{% assign product = closest.product %}
{% assign accordion_items = 'details,package,size_materials,care,shipping' | split: ',' %}

<div class="astranova-product-accordion-block" {{ block.shopify_attributes }}>
  {% for item in accordion_items %}
    <details class="astranova-detail" {% if forloop.first %}open{% endif %}>
      <summary>
        <span>{{ 'astranova.product.accordion.' | append: item | append: '.title' | t }}</span>
        <span class="astranova-detail__caret"></span>
      </summary>
      <div class="astranova-detail__content astranova-richtext">
        {% liquid
          case item
            when 'details'
              assign metafield = product.metafields.custom.product_details
            when 'size_materials'
              assign metafield = product.metafields.custom.size_and_materials
            when 'package'
              assign metafield = product.metafields.custom.package_contents
            when 'care'
              assign metafield = product.metafields.custom.care_and_use
            else
              assign metafield = product.metafields.custom.shipping_and_returns
          endcase

          if metafield != blank
            echo metafield | metafield_tag
          else
            echo 'astranova.product.accordion.' | append: item | append: '.default_html' | t
          endif
        %}
      </div>
    </details>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Astranova Accordion",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "Astranova Accordion",
      "category": "Product"
    }
  ]
}
{% endschema %}
