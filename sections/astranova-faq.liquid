<div class="section-background color-{{ section.settings.color_scheme }}"></div>
{% assign faq_items = 'one,two,three,four' | split: ',' %}
<section
  class="astranova-faq section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="padding-block: {{ section.settings.padding_block_start }}px {{ section.settings.padding_block_end }}px;"
  {{ section.shopify_attributes }}
>
  <div class="astranova-faq__header">
    <p class="astranova-eyebrow">{{ 'astranova.faq.eyebrow' | t }}</p>
    <h2 class="astranova-section-heading">{{ 'astranova.faq.title' | t }}</h2>
    <p class="astranova-section-copy">{{ 'astranova.faq.body' | t }}</p>
  </div>

  <div class="astranova-panel astranova-faq__panel">
    {% for item in faq_items %}
      <details class="astranova-detail" {% if forloop.first %}open{% endif %}>
        <summary>
          <span>{{ 'astranova.faq.' | append: item | append: '.question' | t }}</span>
          <span class="astranova-detail__caret"></span>
        </summary>
        <div class="astranova-detail__content astranova-richtext">
          {{ 'astranova.faq.' | append: item | append: '.answer_html' | t }}
        </div>
      </details>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .astranova-faq__header {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .astranova-faq__panel {
    padding: 0 1.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Astranova FAQ",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Astranova FAQ"
    }
  ]
}
{% endschema %}
