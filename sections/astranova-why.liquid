<section
  class="astranova-why section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="padding-block: {{ section.settings.padding_block_start }}px {{ section.settings.padding_block_end }}px;"
  {{ section.shopify_attributes }}
>
  <div class="astranova-why__grid">
    <article class="astranova-why__story">
      <img
        src="{{ 'astranova-horizon-story.png' | asset_url }}"
        alt=""
        width="1536"
        height="1024"
        loading="lazy"
        class="astranova-why__image"
      >
      <div class="astranova-why__story-content">
        <p class="astranova-eyebrow astranova-eyebrow--light">{{ 'astranova.why.eyebrow' | t }}</p>
        <h2>{{ 'astranova.why.title' | t }}</h2>
        <p>{{ 'astranova.why.body' | t }}</p>
        <a class="button-secondary astranova-hero__secondary" href="{{ section.settings.link | default: routes.root_url }}">
          {{ 'astranova.why.cta' | t }}
        </a>
      </div>
    </article>

    <article class="astranova-why__trust">
      <h2>{{ 'astranova.why.trust_title' | t }}</h2>
      <div class="astranova-why__trust-grid">
        {% assign items = 'payments,delivery,returns,support' | split: ',' %}
        {% for item in items %}
          <div class="astranova-why__trust-item">
            <span class="astranova-why__trust-mark" aria-hidden="true">✓</span>
            <div>
              <h3>{{ 'astranova.why.' | append: item | append: '.title' | t }}</h3>
              <p>{{ 'astranova.why.' | append: item | append: '.body' | t }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </article>
  </div>
</section>

{% stylesheet %}
  .astranova-why__grid {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--astranova-border);
    border-radius: var(--astranova-radius);
    background: #fff;
    box-shadow: var(--astranova-shadow);
  }

  .astranova-why__story,
  .astranova-why__trust {
    position: relative;
    min-height: 28rem;
  }

  .astranova-why__story {
    display: grid;
    align-items: end;
    overflow: hidden;
    color: #fff;
    background: #040719;
  }

  .astranova-why__story::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(3, 6, 21, 0.96), rgba(3, 6, 21, 0.52) 68%, rgba(3, 6, 21, 0.12));
  }

  .astranova-why__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .astranova-why__story-content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
    max-width: 34rem;
    padding: clamp(1.6rem, 4vw, 3.25rem);
  }

  .astranova-why__story h2,
  .astranova-why__story p,
  .astranova-why__trust h2,
  .astranova-why__trust h3,
  .astranova-why__trust p {
    margin: 0;
  }

  .astranova-why__story h2 {
    color: #fff;
    font-size: clamp(2.2rem, 4vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .astranova-why__story p {
    color: rgba(239, 243, 255, 0.72);
    line-height: 1.65;
  }

  .astranova-why__story .button-secondary {
    width: fit-content;
  }

  .astranova-why__trust {
    display: grid;
    align-content: center;
    gap: 2rem;
    padding: clamp(1.6rem, 4vw, 3.25rem);
    background:
      radial-gradient(circle at top right, rgba(105, 79, 255, 0.09), transparent 42%),
      #fff;
  }

  .astranova-why__trust > h2 {
    color: var(--astranova-foreground);
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    letter-spacing: -0.045em;
  }

  .astranova-why__trust-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .astranova-why__trust-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    padding: 1.4rem 1rem;
    border-top: 1px solid var(--astranova-border);
  }

  .astranova-why__trust-item:nth-child(odd) {
    border-right: 1px solid var(--astranova-border);
  }

  .astranova-why__trust-mark {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 50%;
    color: var(--astranova-violet);
    background: var(--astranova-lavender);
  }

  .astranova-why__trust-item h3 {
    color: var(--astranova-foreground);
    font-size: 0.95rem;
  }

  .astranova-why__trust-item p {
    margin-top: 0.25rem;
    color: var(--astranova-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  @media screen and (min-width: 990px) {
    .astranova-why__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .astranova-why__story,
    .astranova-why__trust {
      min-height: auto;
    }

    .astranova-why__story {
      min-height: 28rem;
    }

    .astranova-why__trust-grid {
      grid-template-columns: 1fr;
    }

    .astranova-why__trust-item:nth-child(odd) {
      border-right: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Astranova Why",
  "settings": [
    { "type": "url", "id": "link", "label": "Story link" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_block_start", "label": "Top padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_block_end", "label": "Bottom padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 28 }
  ],
  "presets": [{ "name": "Astranova Why" }]
}
{% endschema %}
