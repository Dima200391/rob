<section
  class="astranova-categories section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="padding-block: {{ section.settings.padding_block_start }}px {{ section.settings.padding_block_end }}px;"
  {{ section.shopify_attributes }}
>
  <div class="astranova-section-head">
    <div>
      <p class="astranova-eyebrow">{{ 'astranova.collections.eyebrow' | t }}</p>
      <h2 class="astranova-section-heading">{{ 'astranova.collections.title' | t }}</h2>
    </div>
    <a class="astranova-link" href="{{ routes.collections_url }}">{{ 'astranova.collections.view_all' | t }} →</a>
  </div>

  <div class="astranova-categories__grid">
    {% for block in section.blocks %}
      {% liquid
        assign category_collection = block.settings.collection
        assign category_link = block.settings.link
        if category_link == blank and category_collection != blank
          assign category_link = category_collection.url
        endif
        if category_link == blank
          assign category_link = routes.collections_url
        endif

        assign category_image = block.settings.image
        if category_image == blank and category_collection != blank
          assign category_image = category_collection.featured_image
        endif

        assign fallback_key = block.settings.fallback_key | default: 'electronics'
        assign title_key = 'astranova.collections.' | append: fallback_key | append: '.title'
        assign body_key = 'astranova.collections.' | append: fallback_key | append: '.body'
        assign category_title = block.settings.title | default: category_collection.title
        case fallback_key
          when 'electronics'
            assign fallback_asset = 'astranova-collection-smart.svg'
          when 'accessories'
            assign fallback_asset = 'astranova-collection-style.svg'
          when 'home'
            assign fallback_asset = 'astranova-collection-home.svg'
          when 'gifts'
            assign fallback_asset = 'astranova-collection-beauty.svg'
          else
            assign fallback_asset = 'astranova-hero-electronics.png'
        endcase
      %}
      <a class="astranova-categories__card" href="{{ category_link }}" {{ block.shopify_attributes }}>
        <div class="astranova-categories__media">
          {% if category_image != blank %}
            {{ category_image | image_url: width: 720 | image_tag: loading: 'lazy', class: 'astranova-categories__image' }}
          {% else %}
            <img
              src="{{ fallback_asset | asset_url }}"
              alt=""
              width="720"
              height="640"
              loading="lazy"
              class="astranova-categories__image"
            >
          {% endif %}
        </div>
        <div class="astranova-categories__content">
          <div>
            <h3>
              {% if category_title != blank %}
                {{ category_title }}
              {% else %}
                {{ title_key | t }}
              {% endif %}
            </h3>
            <p>
              {% if block.settings.body != blank %}
                {{ block.settings.body }}
              {% else %}
                {{ body_key | t }}
              {% endif %}
            </p>
          </div>
          <span class="astranova-categories__arrow" aria-hidden="true">→</span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .astranova-section-head {
    display: flex;
    gap: 1.5rem;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .astranova-section-head > div {
    display: grid;
    gap: 0.55rem;
  }

  .astranova-categories__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
  }

  .astranova-categories__card {
    overflow: hidden;
    min-width: 0;
    border: 1px solid var(--astranova-border);
    border-radius: var(--astranova-radius-sm);
    color: inherit;
    background: #fff;
    box-shadow: 0 12px 40px rgba(13, 18, 44, 0.06);
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .astranova-categories__card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 50px rgba(13, 18, 44, 0.12);
  }

  .astranova-categories__media {
    aspect-ratio: 1 / 0.88;
    overflow: hidden;
    background: linear-gradient(145deg, #f0efff, #faf9ff);
  }

  .astranova-categories__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms ease;
  }

  .astranova-categories__card:hover .astranova-categories__image {
    transform: scale(1.04);
  }

  .astranova-categories__content {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem;
    align-items: center;
    padding: 1rem;
  }

  .astranova-categories__content h3,
  .astranova-categories__content p {
    margin: 0;
  }

  .astranova-categories__content h3 {
    color: var(--astranova-foreground);
    font-size: 1rem;
    letter-spacing: -0.025em;
  }

  .astranova-categories__content p {
    margin-top: 0.25rem;
    color: var(--astranova-muted);
    font-size: 0.76rem;
    line-height: 1.35;
  }

  .astranova-categories__arrow {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    color: var(--astranova-violet);
    background: var(--astranova-lavender);
  }

  @media screen and (max-width: 989px) {
    .astranova-categories__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .astranova-section-head {
      align-items: start;
    }

    .astranova-categories__grid {
      display: flex;
      margin-inline: calc(var(--page-margin) * -1);
      padding-inline: var(--page-margin);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .astranova-categories__card {
      flex: 0 0 76%;
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Astranova Categories",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "body", "label": "Description" },
        { "type": "url", "id": "link", "label": "Custom link" },
        {
          "type": "select",
          "id": "fallback_key",
          "label": "Fallback content",
          "options": [
            { "value": "electronics", "label": "Electronics" },
            { "value": "accessories", "label": "Accessories" },
            { "value": "home", "label": "Home" },
            { "value": "gifts", "label": "Gifts" },
            { "value": "new_arrivals", "label": "New arrivals" }
          ],
          "default": "electronics"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_block_start", "label": "Top padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_block_end", "label": "Bottom padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 28 }
  ],
  "presets": [
    {
      "name": "Astranova Categories",
      "blocks": [
        { "type": "category", "settings": { "fallback_key": "electronics" } },
        { "type": "category", "settings": { "fallback_key": "accessories" } },
        { "type": "category", "settings": { "fallback_key": "home" } },
        { "type": "category", "settings": { "fallback_key": "gifts" } },
        { "type": "category", "settings": { "fallback_key": "new_arrivals" } }
      ]
    }
  ]
}
{% endschema %}
