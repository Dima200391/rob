{% liquid
  assign collection_link_home = section.settings.home_link | default: '/collections/home-living'
  assign collection_link_beauty = section.settings.beauty_link | default: '/collections/beauty-wellness'
  assign collection_link_style = section.settings.style_link | default: '/collections/style-accessories'
  assign collection_link_smart = section.settings.smart_link | default: '/collections/smart-finds'
  assign astranova_collection_items = 'home,beauty,style,smart' | split: ','
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="astranova-collections section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="padding-block: {{ section.settings.padding_block_start }}px {{ section.settings.padding_block_end }}px;"
  {{ section.shopify_attributes }}
>
  <div class="astranova-collections__header">
    <p class="astranova-eyebrow">{{ 'astranova.collections.eyebrow' | t }}</p>
    <h2 class="astranova-section-heading">{{ 'astranova.collections.title' | t }}</h2>
    <p class="astranova-section-copy">{{ 'astranova.collections.body' | t }}</p>
  </div>

  <div class="astranova-card-grid astranova-card-grid--4">
    {% for item in astranova_collection_items %}
      {% liquid
        case item
          when 'home'
            assign link = collection_link_home
          when 'beauty'
            assign link = collection_link_beauty
          when 'style'
            assign link = collection_link_style
          else
            assign link = collection_link_smart
        endcase
      %}
      <a href="{{ link }}" class="astranova-panel astranova-panel--compact astranova-collections__card">
        <span class="astranova-tag">{{ 'astranova.collections.' | append: item | append: '.tag' | t }}</span>
        <div class="astranova-collections__number">0{{ forloop.index }}</div>
        <h3 class="astranova-collections__card-title">{{ 'astranova.collections.' | append: item | append: '.title' | t }}</h3>
        <p class="astranova-collections__card-copy">{{ 'astranova.collections.' | append: item | append: '.body' | t }}</p>
        <span class="astranova-collections__cta">{{ 'astranova.collections.cta' | t }}</span>
      </a>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .astranova-collections__header {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .astranova-collections__card {
    display: grid;
    gap: 0.95rem;
    padding: 1.5rem;
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    background:
      linear-gradient(165deg, rgba(255, 255, 255, 0.82), rgba(250, 245, 240, 0.72)),
      radial-gradient(circle at top right, rgba(56, 80, 107, 0.12), transparent 34%);
  }

  .astranova-collections__card:hover {
    transform: translateY(-6px);
    border-color: rgba(56, 80, 107, 0.24);
    box-shadow: 0 18px 42px rgba(23, 21, 28, 0.08);
  }

  .astranova-collections__number {
    color: rgba(56, 80, 107, 0.18);
    font-family: var(--font-heading--family);
    font-size: clamp(2.2rem, 4vw, 3.3rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .astranova-collections__card-title {
    margin: 0;
    color: var(--astranova-foreground);
    font-size: 1.25rem;
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .astranova-collections__card-copy {
    margin: 0;
    color: var(--astranova-muted);
    line-height: 1.6;
  }

  .astranova-collections__cta {
    color: var(--astranova-accent-strong);
    font-weight: 700;
    letter-spacing: 0.02em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Astranova Collections",
  "settings": [
    {
      "type": "url",
      "id": "home_link",
      "label": "Home & living link"
    },
    {
      "type": "url",
      "id": "beauty_link",
      "label": "Beauty & wellness link"
    },
    {
      "type": "url",
      "id": "style_link",
      "label": "Style & accessories link"
    },
    {
      "type": "url",
      "id": "smart_link",
      "label": "Smart finds link"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Astranova Collections"
    }
  ]
}
{% endschema %}
