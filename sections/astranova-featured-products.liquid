{% liquid
  assign max_items = section.settings.max_products
  assign featured_collection = section.settings.collection
  assign has_featured_products = false
  if featured_collection != blank and featured_collection.products_count > 0
    assign has_featured_products = true
    assign featured_count = featured_collection.products_count | at_most: max_items
  endif
%}

<section
  class="astranova-featured section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="padding-block: {{ section.settings.padding_block_start }}px {{ section.settings.padding_block_end }}px;"
  {{ section.shopify_attributes }}
>
  <div class="astranova-section-head">
    <div>
      <p class="astranova-eyebrow">{{ 'astranova.featured.eyebrow' | t }}</p>
      <h2 class="astranova-section-heading">{{ 'astranova.featured.title' | t }}</h2>
    </div>
    {% if has_featured_products %}
      <a class="astranova-link" href="{{ featured_collection.url }}">
        {{ 'astranova.featured.view_all' | t }}
        <span class="astranova-link__icon" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
      </a>
    {% endif %}
  </div>

  {% if has_featured_products %}
    {% capture list_items %}
      {% for product in featured_collection.products limit: max_items %}
        <div class="resource-list__item">
          {% # theme-check-disable UniqueStaticBlockId %}
            {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product %}
          {% # theme-check-enable UniqueStaticBlockId %}
        </div>
        {% unless forloop.last %}<!--@list/split-->{% endunless %}
      {% endfor %}
    {% endcapture %}

    {% assign list_items_array = list_items | strip | split: '<!--@list/split-->' %}
    {% render 'resource-list',
      list_items: list_items,
      list_items_array: list_items_array,
      settings: section.settings,
      slide_count: featured_count,
      content_type: 'products',
      test_id: 'astranova-featured-products'
    %}
  {% else %}
    <div class="astranova-featured__empty">
      <div>
        <p class="astranova-featured__empty-kicker">{{ 'astranova.featured.empty_kicker' | t }}</p>
        <h3>{{ 'astranova.featured.empty_title' | t }}</h3>
        <p>{{ 'astranova.featured.empty_body' | t }}</p>
      </div>
      <a class="button-secondary" href="{{ routes.collections_url }}">{{ 'astranova.featured.empty_cta' | t }}</a>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .astranova-featured .astranova-link__icon {
    width: 0.9rem;
    height: 0.9rem;
  }

  .astranova-featured__empty {
    display: flex;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
    min-height: 13rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--astranova-border);
    border-radius: var(--astranova-radius);
    background: linear-gradient(135deg, #f7f6ff, #fff);
  }

  .astranova-featured__empty > div {
    display: grid;
    gap: 0.65rem;
    max-width: 40rem;
  }

  .astranova-featured__empty-kicker,
  .astranova-featured__empty h3,
  .astranova-featured__empty p {
    margin: 0;
  }

  .astranova-featured__empty-kicker {
    color: var(--astranova-violet);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .astranova-featured__empty h3 {
    font-size: clamp(1.45rem, 3vw, 2.25rem);
    letter-spacing: -0.04em;
  }

  .astranova-featured__empty p {
    color: var(--astranova-muted);
    line-height: 1.65;
  }

  @media screen and (max-width: 749px) {
    .astranova-featured__empty {
      display: grid;
      min-height: 0;
    }

    .astranova-featured__empty .button-secondary {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Astranova Featured",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "max_products", "label": "Product count", "min": 2, "max": 12, "step": 1, "default": 5 },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "carousel"
    },
    { "type": "checkbox", "id": "carousel_on_mobile", "label": "Carousel on mobile", "default": true },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 6, "step": 1, "default": 5 },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "One" },
        { "value": "2", "label": "Two" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "mobile_card_size",
      "label": "Mobile card size",
      "options": [
        { "value": "60cqw", "label": "Large" },
        { "value": "44cqw", "label": "Compact" }
      ],
      "default": "60cqw"
    },
    { "type": "range", "id": "columns_gap", "label": "Column gap", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "rows_gap", "label": "Row gap", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 24 },
    {
      "type": "select",
      "id": "icons_style",
      "label": "Navigation icon",
      "options": [
        { "value": "arrow", "label": "Arrow" },
        { "value": "chevron", "label": "Chevron" }
      ],
      "default": "arrow"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "Navigation shape",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "circle", "label": "Circle" }
      ],
      "default": "circle"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_block_start", "label": "Top padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_block_end", "label": "Bottom padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 44 }
  ],
  "presets": [{ "name": "Astranova Featured Products" }]
}
{% endschema %}
