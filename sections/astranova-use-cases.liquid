<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="astranova-use-cases section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="padding-block: {{ section.settings.padding_block_start }}px {{ section.settings.padding_block_end }}px;"
  {{ section.shopify_attributes }}
>
  <div class="astranova-use-cases__header">
    <p class="astranova-eyebrow">{{ 'astranova.use_cases.eyebrow' | t }}</p>
    <h2 class="astranova-section-heading">{{ 'astranova.use_cases.title' | t }}</h2>
    <p class="astranova-section-copy">{{ 'astranova.use_cases.body' | t }}</p>
  </div>

  <div class="astranova-card-grid astranova-card-grid--4">
    {% for item in 'home,work,travel,gifting' | split: ',' %}
      <div class="astranova-panel astranova-panel--compact astranova-use-cases__card">
        <p class="astranova-use-cases__card-kicker">{{ 'astranova.use_cases.' | append: item | append: '.kicker' | t }}</p>
        <h3 class="astranova-use-cases__card-title">{{ 'astranova.use_cases.' | append: item | append: '.title' | t }}</h3>
        <p class="astranova-use-cases__card-copy">{{ 'astranova.use_cases.' | append: item | append: '.body' | t }}</p>
      </div>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .astranova-use-cases__header {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .astranova-use-cases__card {
    display: grid;
    gap: 0.8rem;
    padding: 1.4rem;
  }

  .astranova-use-cases__card-kicker {
    margin: 0;
    color: var(--astranova-accent-strong);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .astranova-use-cases__card-title {
    margin: 0;
    color: var(--astranova-foreground);
    font-size: 1.2rem;
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .astranova-use-cases__card-copy {
    margin: 0;
    color: var(--astranova-muted);
    line-height: 1.6;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Astranova Use Cases",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Astranova Use Cases"
    }
  ]
}
{% endschema %}
