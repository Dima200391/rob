<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="astranova-testimonials section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="padding-block: {{ section.settings.padding_block_start }}px {{ section.settings.padding_block_end }}px;"
  {{ section.shopify_attributes }}
>
  <div class="astranova-testimonials__header">
    <p class="astranova-eyebrow">{{ 'astranova.testimonials.eyebrow' | t }}</p>
    <h2 class="astranova-section-heading">{{ 'astranova.testimonials.title' | t }}</h2>
    <p class="astranova-section-copy">{{ 'astranova.testimonials.body' | t }}</p>
  </div>

  <div class="astranova-card-grid astranova-card-grid--3">
    {% for item in 'one,two,three' | split: ',' %}
      <article class="astranova-panel astranova-panel--compact astranova-testimonials__card">
        <p class="astranova-testimonials__rating">5/5</p>
        <blockquote class="astranova-testimonials__quote">{{ 'astranova.testimonials.' | append: item | append: '.quote' | t }}</blockquote>
        <p class="astranova-testimonials__meta">
          <strong>{{ 'astranova.testimonials.' | append: item | append: '.name' | t }}</strong>
          <span>{{ 'astranova.testimonials.' | append: item | append: '.meta' | t }}</span>
        </p>
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .astranova-testimonials__header {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .astranova-testimonials__card {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
  }

  .astranova-testimonials__rating {
    margin: 0;
    color: var(--astranova-accent-strong);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .astranova-testimonials__quote {
    margin: 0;
    color: var(--astranova-foreground);
    font-size: 1.15rem;
    line-height: 1.65;
  }

  .astranova-testimonials__meta {
    display: grid;
    gap: 0.2rem;
    margin: 0;
    color: var(--astranova-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Astranova Testimonials",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Astranova Testimonials"
    }
  ]
}
{% endschema %}
