{% liquid
  assign primary_link = section.settings.primary_link | default: '/collections/all'
  assign secondary_link = section.settings.secondary_link | default: '/collections/new-in'
  assign astranova_hero_chip_items = 'curated,shipping,gifting' | split: ','
  assign astranova_hero_stat_items = 'catalog,discovery,support' | split: ','
  assign astranova_hero_orbit_items = 'home,beauty,style,smart' | split: ','
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="astranova-shell astranova-hero section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="padding-block: {{ section.settings.padding_block_start }}px {{ section.settings.padding_block_end }}px;"
  {{ section.shopify_attributes }}
>
  <div class="astranova-hero__grid">
    <div class="astranova-hero__content">
      <p class="astranova-eyebrow">{{ 'astranova.hero.eyebrow' | t }}</p>
      <h1 class="astranova-hero__title">{{ 'astranova.hero.title' | t }}</h1>
      <p class="astranova-section-copy">{{ 'astranova.hero.body' | t }}</p>

      <div class="astranova-hero__actions">
        <a href="{{ primary_link }}" class="button">{{ 'astranova.hero.primary_cta' | t }}</a>
        <a href="{{ secondary_link }}" class="button-secondary">{{ 'astranova.hero.secondary_cta' | t }}</a>
      </div>

      <ul class="astranova-hero__chips" role="list">
        {% for item in astranova_hero_chip_items %}
          {% assign chip_key = 'astranova.hero.chips.' | append: item %}
          <li class="astranova-tag">{{ chip_key | t }}</li>
        {% endfor %}
      </ul>
    </div>

    <div class="astranova-panel astranova-hero__panel">
      <div class="astranova-hero__panel-copy">
        <p class="astranova-eyebrow">{{ 'astranova.hero.panel_eyebrow' | t }}</p>
        <h2 class="astranova-hero__panel-title">{{ 'astranova.hero.panel_title' | t }}</h2>
        <p class="astranova-section-copy">{{ 'astranova.hero.panel_body' | t }}</p>
      </div>

      <div class="astranova-card-grid astranova-card-grid--3 astranova-hero__stats">
        {% for item in astranova_hero_stat_items %}
          <div class="astranova-stat">
            <div class="astranova-stat__value">{{ 'astranova.hero.stats.' | append: item | append: '.value' | t }}</div>
            <div class="astranova-stat__label">{{ 'astranova.hero.stats.' | append: item | append: '.label' | t }}</div>
          </div>
        {% endfor %}
      </div>

      <div class="astranova-hero__mini-grid">
        {% for item in astranova_hero_orbit_items %}
          <article class="astranova-hero__mini-card">
            <p class="astranova-hero__mini-index">0{{ forloop.index }}</p>
            <h3 class="astranova-hero__mini-title">{{ 'astranova.hero.orbit.' | append: item | append: '.title' | t }}</h3>
            <p class="astranova-hero__mini-copy">{{ 'astranova.hero.orbit.' | append: item | append: '.body' | t }}</p>
          </article>
        {% endfor %}
      </div>

      <div class="astranova-hero__signal">
        <div class="astranova-hero__signal-orbit"></div>
        <div class="astranova-hero__signal-core"></div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .astranova-hero__grid {
    position: relative;
    display: grid;
    gap: 1.5rem;
    align-items: stretch;
  }

  .astranova-hero__content,
  .astranova-hero__panel {
    position: relative;
    z-index: 1;
  }

  .astranova-hero__content {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 4vw, 4rem);
    border: 1px solid var(--astranova-border);
    border-radius: var(--astranova-radius);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(255, 251, 247, 0.78)),
      radial-gradient(circle at top right, rgba(56, 80, 107, 0.16), transparent 34%),
      radial-gradient(circle at bottom left, rgba(200, 163, 123, 0.14), transparent 30%);
    box-shadow: var(--astranova-shadow);
  }

  .astranova-hero__title {
    margin: 0;
    color: var(--astranova-foreground);
    font-size: clamp(3rem, 7vw, 6.2rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
    max-width: 8.6ch;
  }

  .astranova-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .astranova-hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .astranova-hero__panel {
    overflow: hidden;
    display: grid;
    gap: 1.35rem;
    padding: clamp(1.5rem, 3vw, 2.4rem);
    min-height: 100%;
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.82), rgba(250, 244, 238, 0.7)),
      radial-gradient(circle at 85% 0, rgba(56, 80, 107, 0.18), transparent 32%);
  }

  .astranova-hero__panel-title {
    margin: 0.5rem 0 0;
    color: var(--astranova-foreground);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .astranova-hero__stats {
    align-items: start;
  }

  .astranova-hero__mini-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .astranova-hero__mini-card {
    display: grid;
    gap: 0.45rem;
    padding: 1rem;
    border: 1px solid rgba(56, 80, 107, 0.14);
    border-radius: calc(var(--astranova-radius-sm) - 2px);
    background: rgba(255, 255, 255, 0.68);
    backdrop-filter: blur(12px);
  }

  .astranova-hero__mini-index {
    margin: 0;
    color: rgba(56, 80, 107, 0.5);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .astranova-hero__mini-title {
    margin: 0;
    color: var(--astranova-foreground);
    font-size: 1rem;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .astranova-hero__mini-copy {
    margin: 0;
    color: var(--astranova-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .astranova-hero__signal {
    position: absolute;
    right: -2rem;
    bottom: -1.5rem;
    width: 13rem;
    height: 13rem;
    border-radius: 999px;
    opacity: 0.9;
  }

  .astranova-hero__signal-orbit,
  .astranova-hero__signal-core {
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .astranova-hero__signal-orbit {
    border: 1px solid rgba(56, 80, 107, 0.18);
    transform: scale(0.7);
  }

  .astranova-hero__signal-core {
    inset: 34%;
    background: radial-gradient(circle, rgba(200, 163, 123, 0.95), rgba(200, 163, 123, 0.2));
    box-shadow: 0 0 60px rgba(200, 163, 123, 0.22);
  }

  @media screen and (max-width: 749px) {
    .astranova-hero__mini-grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (min-width: 990px) {
    .astranova-hero__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(24rem, 0.9fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Astranova Hero",
  "settings": [
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top padding",
      "min": 24,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom padding",
      "min": 24,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Astranova Hero"
    }
  ]
}
{% endschema %}
