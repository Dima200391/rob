{% liquid
  assign primary_link = section.settings.primary_link | default: routes.all_products_collection_url
  assign secondary_link = section.settings.secondary_link | default: routes.collections_url
  assign trust_items = 'shipping,returns,checkout' | split: ','
%}

<section
  class="astranova-hero color-{{ section.settings.color_scheme }}"
  style="--astranova-hero-min-height: {{ section.settings.min_height }}px;"
  {{ section.shopify_attributes }}
>
  <img
    src="{{ 'astranova-hero-electronics.png' | asset_url }}"
    alt=""
    width="1536"
    height="1024"
    class="astranova-hero__image"
    fetchpriority="high"
  >
  <div class="astranova-hero__veil"></div>
  <div class="astranova-hero__stars"></div>

  <div class="astranova-hero__inner page-width">
    <div class="astranova-hero__content">
      <p class="astranova-eyebrow astranova-eyebrow--light">{{ 'astranova.hero.eyebrow' | t }}</p>
      <h1 class="astranova-hero__title">{{ 'astranova.hero.title' | t }}</h1>
      <p class="astranova-hero__copy">{{ 'astranova.hero.body' | t }}</p>

      <div class="astranova-hero__actions">
        <a href="{{ primary_link }}" class="button">{{ 'astranova.hero.primary_cta' | t }}</a>
        <a href="{{ secondary_link }}" class="button-secondary astranova-hero__secondary">
          {{ 'astranova.hero.secondary_cta' | t }}
        </a>
      </div>

      <ul class="astranova-hero__trust" role="list">
        {% for item in trust_items %}
          <li class="astranova-hero__trust-item">
            <span class="astranova-hero__trust-icon">
              {{ 'icon-checkmark.svg' | inline_asset_content }}
            </span>
            <span>
              <strong>{{ 'astranova.hero.trust.' | append: item | append: '.title' | t }}</strong>
              <small>{{ 'astranova.hero.trust.' | append: item | append: '.body' | t }}</small>
            </span>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{% stylesheet %}
  .astranova-hero {
    position: relative;
    min-height: var(--astranova-hero-min-height);
    overflow: hidden;
    isolation: isolate;
    background: #030716;
    color: #fff;
  }

  .astranova-hero__image,
  .astranova-hero__veil,
  .astranova-hero__stars {
    position: absolute;
    inset: 0;
  }

  .astranova-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: -3;
  }

  .astranova-hero__veil {
    z-index: -2;
    background:
      linear-gradient(90deg, rgba(2, 5, 18, 0.98) 0%, rgba(2, 5, 18, 0.88) 35%, rgba(2, 5, 18, 0.2) 66%, rgba(2, 5, 18, 0.48) 100%),
      linear-gradient(180deg, rgba(3, 7, 22, 0.18), rgba(3, 7, 22, 0.78));
  }

  .astranova-hero__stars {
    z-index: -1;
    opacity: 0.22;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.72) 1px, transparent 1.2px);
    background-size: 52px 52px;
    mask-image: linear-gradient(90deg, transparent, #000 45%, #000);
  }

  .astranova-hero__inner {
    display: grid;
    align-items: center;
    min-height: var(--astranova-hero-min-height);
    padding-block: clamp(4.5rem, 10vw, 8rem) clamp(2.5rem, 6vw, 4.5rem);
    padding-inline: clamp(1.25rem, 3vw, 3.25rem);
  }

  .astranova-hero__content {
    display: grid;
    gap: 1.35rem;
    width: min(42rem, 55%);
  }

  .astranova-hero__title {
    max-width: 10ch;
    margin: 0;
    color: #fff;
    font-size: clamp(3.2rem, 5vw, 4.8rem);
    line-height: 0.93;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }

  .astranova-hero__copy {
    max-width: 34rem;
    margin: 0;
    color: rgba(239, 243, 255, 0.78);
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    line-height: 1.65;
  }

  .astranova-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .astranova-hero__secondary {
    border-color: rgba(255, 255, 255, 0.42);
    color: #fff;
    background: rgba(255, 255, 255, 0.04);
  }

  .astranova-hero__trust {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 1rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    list-style: none;
  }

  .astranova-hero__trust-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.65rem;
    align-items: center;
    min-width: 0;
  }

  .astranova-hero__trust-icon {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 50%;
    color: #aeb8ff;
  }

  .astranova-hero__trust-icon svg {
    width: 0.8rem;
    height: 0.8rem;
  }

  .astranova-hero__trust-item strong,
  .astranova-hero__trust-item small {
    display: block;
  }

  .astranova-hero__trust-item strong {
    color: #fff;
    font-size: 0.83rem;
  }

  .astranova-hero__trust-item small {
    margin-top: 0.15rem;
    color: rgba(239, 243, 255, 0.58);
    font-size: 0.72rem;
    line-height: 1.35;
  }

  @media screen and (max-width: 989px) {
    .astranova-hero__image {
      object-position: 64% center;
    }

    .astranova-hero__veil {
      background:
        linear-gradient(90deg, rgba(2, 5, 18, 0.98), rgba(2, 5, 18, 0.8) 58%, rgba(2, 5, 18, 0.4)),
        linear-gradient(180deg, rgba(3, 7, 22, 0.18), rgba(3, 7, 22, 0.82));
    }

    .astranova-hero__content {
      width: min(36rem, 72%);
    }
  }

  @media screen and (max-width: 749px) {
    .astranova-hero {
      min-height: 48rem;
    }

    .astranova-hero__image {
      height: 58%;
      inset: auto 0 0;
      object-position: 66% bottom;
    }

    .astranova-hero__veil {
      background:
        linear-gradient(180deg, rgba(2, 5, 18, 0.99) 0%, rgba(2, 5, 18, 0.94) 48%, rgba(2, 5, 18, 0.32) 76%, rgba(2, 5, 18, 0.74) 100%);
    }

    .astranova-hero__inner {
      align-items: start;
      min-height: 48rem;
      padding-block: 4rem 2rem;
    }

    .astranova-hero__content {
      width: 100%;
      gap: 1rem;
    }

    .astranova-hero__title {
      max-width: 9ch;
      font-size: clamp(3rem, 14vw, 4.4rem);
    }

    .astranova-hero__copy {
      max-width: 29rem;
    }

    .astranova-hero__trust {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Astranova Hero",
  "settings": [
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 520,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-5" }
  ],
  "presets": [{ "name": "Astranova Hero" }]
}
{% endschema %}
