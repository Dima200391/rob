            "astranova_specs": {
              "type": "astranova-specifications",
              "settings": {},
              "blocks": {}
            },
            "astranova_support": {
              "type": "astranova-product-accordion",
              "settings": {},
              "blocks": {}
            },
            "complementary_products": {
              "type": "product-recommendations",
              "settings": {
                "recommendation_type": "complementary",
                "layout_type": "grid",
                "carousel_on_mobile": true,
                "max_products": 3,
                "columns": 3,
                "mobile_columns": "2",
                "columns_gap": 12,
                "rows_gap": 16,
                "icons_style": "arrow",
                "icons_shape": "circle",
                "gap": 16
