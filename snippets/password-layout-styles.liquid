{%- doc -%}
  Styles for the password layout: main content, password dialog, and email-signup
  used in the dialog. Rendered from layout/password.liquid (layouts cannot use the
  stylesheet tag directly).
{%- enddoc -%}

{% stylesheet %}
  body.password-page,
  body {
    background:
      radial-gradient(circle at top left, rgb(255 255 255 / 0.92), transparent 34%),
      radial-gradient(circle at 82% 18%, rgb(214 188 157 / 0.18), transparent 26%),
      linear-gradient(180deg, #fbf7f2 0%, #f4ede5 52%, #efe6dd 100%);
    color: #17151c;
  }

  .password-main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .password-main-content::before,
  .password-main-content::after {
    content: '';
    position: fixed;
    inset: auto;
    border-radius: 999px;
    pointer-events: none;
    filter: blur(8px);
    opacity: 0.75;
    z-index: 0;
  }

  .password-main-content::before {
    top: 12vh;
    left: 6vw;
    width: clamp(12rem, 28vw, 26rem);
    height: clamp(12rem, 28vw, 26rem);
    background: radial-gradient(circle, rgb(200 163 123 / 0.22) 0%, transparent 72%);
  }

  .password-main-content::after {
    right: 7vw;
    bottom: 10vh;
    width: clamp(10rem, 20vw, 18rem);
    height: clamp(10rem, 20vw, 18rem);
    background: radial-gradient(circle, rgb(56 80 107 / 0.18) 0%, transparent 70%);
  }

  .password-dialog {
    max-width: 100vw;
    max-height: 100svh;
    width: 100vw;
    height: 100svh;
    border: none;
    background: rgb(20 18 25 / 0.5);
    backdrop-filter: blur(14px);
    transition: opacity var(--animation-values), display var(--animation-speed) allow-discrete,
      overlay var(--animation-speed) allow-discrete;

    &::backdrop {
      background: rgb(20 18 25 / 0.36);
      backdrop-filter: blur(14px);
    }
  }

  .password-dialog[open] {
    opacity: 1;
    top: 0;
    left: 0;
  }

  @starting-style {
    .password-dialog[open] {
      opacity: 0;
    }
  }

  .password-dialog:not([open]) {
    opacity: 0;
  }

  @starting-style {
    .password-dialog:not([open]) {
      opacity: 1;
    }
  }

  .password-dialog__close-button {
    cursor: pointer;
    color: #17151c;
  }

  .password-dialog__header {
    position: absolute;
    top: 0;
    right: 0;
    padding: var(--padding-lg);
    z-index: var(--layer-raised);
  }

  .password-dialog__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: max(2rem, 5vw);
    margin: auto;
    width: min(32rem, calc(100vw - 2rem));
    height: auto;
    min-height: 0;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.98), rgb(248 243 237 / 0.96));
    border: 1px solid rgb(164 147 133 / 0.42);
    border-radius: 32px;
    box-shadow: 0 30px 80px rgb(23 21 28 / 0.22);
    transition: transform var(--animation-values);
  }

  .password-dialog__title {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    letter-spacing: -0.04em;
    text-align: center;
  }

  .password-dialog__content .email-signup__message {
    padding-block-start: 0.5rem;
    text-align: center;
  }

  .password-dialog[open] .password-dialog__content {
    transform: translateY(0);
  }

  @starting-style {
    .password-dialog[open] .password-dialog__content {
      transform: translateY(1em);
    }
  }

  .password-dialog:not([open]) .password-dialog__content {
    transform: translateY(1em);
  }

  @starting-style {
    .password-dialog:not([open]) .password-dialog__content {
      transform: translateY(0);
    }
  }

  .storefront-password-form {
    max-width: 420px;
    width: 100%;
  }

  .email-signup__input-group,
  .password-dialog__submit-button {
    width: 100%;
  }

  .section-password {
    position: relative;
    z-index: 1;
  }

  .section-password .section {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 1rem;
  }

  .section-password [data-testid='section-content'] {
    position: relative;
    width: min(44rem, 100%);
    gap: 1.25rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 36px;
    border: 1px solid rgb(164 147 133 / 0.34);
    background:
      radial-gradient(circle at top right, rgb(200 163 123 / 0.12), transparent 28%),
      linear-gradient(180deg, rgb(255 255 255 / 0.92), rgb(249 244 238 / 0.88));
    box-shadow: 0 24px 70px rgb(23 21 28 / 0.12);
    text-align: center;
    backdrop-filter: blur(18px);
  }

  .section-password h1 {
    margin: 0;
    color: #17151c;
    font-size: clamp(3rem, 8vw, 5.8rem);
    line-height: 0.92;
    letter-spacing: -0.07em;
  }

  .section-password p {
    margin: 0;
    color: #5f5968;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .astranova-password__eyebrow {
    margin: 0 0 0.4rem;
    color: #38506b !important;
    font-size: 0.82rem !important;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .section-password .email-signup {
    width: min(36rem, 100%);
  }

  .section-password .email-signup__input-group {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
    width: 100%;
  }

  .section-password .field {
    width: 100%;
  }

  .section-password .field__input {
    min-height: 3.7rem;
    border-radius: 999px;
    border: 1px solid rgb(164 147 133 / 0.45);
    background: rgb(255 255 255 / 0.82);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.7);
  }

  .section-password .button,
  .password-dialog__submit-button {
    min-height: 3.7rem;
    border: 1px solid rgb(23 21 28 / 0.08);
    border-radius: 999px;
    background: linear-gradient(135deg, #1b202d 0%, #38506b 100%);
    color: #fff;
    font-weight: 700;
    letter-spacing: 0.01em;
    box-shadow: 0 18px 30px rgb(56 80 107 / 0.18);
  }

  .section-password .button:hover,
  .password-dialog__submit-button:hover {
    background: linear-gradient(135deg, #18202c 0%, #2f455e 100%);
  }

  .password-footer {
    position: relative;
    z-index: 1;
    padding: 1rem 1rem 2rem;
  }

  .password-footer__powered-by,
  .password-footer__admin-link,
  .password-footer__button {
    color: #5f5968;
  }

  .password-footer__button {
    text-decoration: none;
    border-bottom: 1px solid rgb(164 147 133 / 0.44);
  }

  @media screen and (min-width: 750px) {
    .section-password [data-testid='section-content'] {
      padding: clamp(2rem, 4vw, 3.5rem);
    }

    .section-password .email-signup__input-group {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    .password-dialog__submit-button {
      width: auto;
      min-width: 9rem;
    }
  }
{% endstylesheet %}
